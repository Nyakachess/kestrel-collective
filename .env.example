# Public origin of the Nest site, read at build time by lib/nest.ts.
# Leave this unset until the nest CNAME is live. Without it the site falls back
# to https://nest.kestrelcollective.org and renders the empty state if that host
# is unreachable.
NEXT_PUBLIC_NEST_URL=https://nest.kestrelcollective.org
# Public address of the Kestrel platform, read at build time by lib/app.ts. Every link to an
# app page (sign up, the rubric, an award check) points here.
NEXT_PUBLIC_APP_URL=https://app.kestrelcollective.org
